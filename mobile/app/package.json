{
  "name": "orbit-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "bundle": "expo export --platform android --platform ios --output-dir /tmp/orbit-bundle",
    "preview": "bash scripts/preview.sh",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.js"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "^1.0.14",
    "expo-blur": "~15.0.0",
    "expo-camera": "~17.0.0",
    "expo-clipboard": "~8.0.0",
    "expo-crypto": "~15.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.0",
    "expo-modules-core": "~3.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-udp": "^4.1.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@types/react": "~19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
