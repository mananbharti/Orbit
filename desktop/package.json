{
  "name": "orbit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit Desktop — local command and transfer service",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/src/main.js",
    "client": "npm run build && node dist/src/integration-client/main.js",
    "test:lan": "npm run build && node --test dist/test/lan-discovery.network.js",
    "test:clipboard:native": "npm run build && node --test dist/test/clipboard.native.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@particle/dbus-next": "0.11.4",
    "bonjour-service": "1.4.4",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
